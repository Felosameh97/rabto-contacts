{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user account preferences and sync metadata.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the owner." },
        "displayName": { "type": "string", "description": "User display name." },
        "email": { "type": "string", "description": "User email address." },
        "githubRepoSlug": { "type": "string", "description": "Optional owner/repo slug for release update checks." },
        "lastSyncEpochMs": { "type": "integer", "description": "Timestamp of last contact sync in epoch ms." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update." }
      },
      "required": ["userId", "displayName", "createdAt", "updatedAt"]
    },
    "ContactRecord": {
      "title": "ContactRecord",
      "description": "Cloud-backed smart contact entry supporting multiple channels, nested category paths, and coordinates.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string", "description": "Full English primary contact display name." },
        "nickname": { "type": "string", "description": "Arabic name and alternate/short names preserved from merges." },
        "primaryPhone": { "type": "string", "description": "Primary phone number or shortcode." },
        "phones": { "type": "array", "description": "Bounded list of phone numbers (max 10)." },
        "emails": { "type": "array", "description": "Bounded list of email addresses (max 5)." },
        "categoryPaths": { "type": "array", "description": "Nested category paths using ' > ' delimiter (max 15)." },
        "tags": { "type": "array", "description": "Searchable bilingual tags describing person's role, study, area, and context (max 20)." },
        "organization": { "type": "string", "description": "Company, university, or institution name." },
        "jobTitle": { "type": "string", "description": "Role or job title." },
        "notes": { "type": "string", "description": "Freeform notes and imported metadata." },
        "address": { "type": "string", "description": "Formatted street or area address." },
        "district": { "type": "string", "description": "District or neighborhood label." },
        "latitude": { "type": "number", "description": "Optional latitude coordinate for map pins." },
        "longitude": { "type": "number", "description": "Optional longitude coordinate for map pins." },
        "telegramHandle": { "type": "string", "description": "Optional Telegram username or phone." },
        "website": { "type": "string", "description": "Optional website URL." },
        "syncedToDevice": { "type": "boolean", "description": "Always false in sandbox isolation mode." },
        "isFavorite": { "type": "boolean", "description": "Pinned to quick access." },
        "avatarColorSeed": { "type": "integer", "description": "Deterministic avatar pastel color seed." },
        "muted": { "type": "boolean", "description": "Whether notifications for this contact are muted." },
        "blocked": { "type": "boolean", "description": "Whether incoming calls from this contact are blocked." },
        "lastContactedEpochMs": { "type": "integer", "description": "Epoch ms of most recent call or interaction." },
        "clientUpdatedAtMs": { "type": "integer", "description": "Client monotonic timestamp for two-way conflict resolution." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp." }
      },
      "required": ["displayName", "primaryPhone", "phones", "emails", "categoryPaths", "syncedToDevice", "isFavorite", "createdAt", "updatedAt"]
    },
    "CategoryNode": {
      "title": "CategoryNode",
      "description": "Hierarchical category node supporting multi-level nested folders.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Leaf folder display name." },
        "parentPath": { "type": "string", "description": "Parent hierarchy path or empty string for root." },
        "fullPath": { "type": "string", "description": "Complete hierarchical path delimited by ' > '." },
        "depth": { "type": "integer", "description": "Nesting level starting at 0." },
        "iconKey": { "type": "string", "description": "Icon identifier." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp." }
      },
      "required": ["name", "parentPath", "fullPath", "depth", "createdAt", "updatedAt"]
    },
    "WhatsAppLog": {
      "title": "WhatsAppLog",
      "description": "Timestamped record of WhatsApp interactions opened from the app.",
      "type": "object",
      "properties": {
        "contactId": { "type": "string", "description": "Referenced contact ID." },
        "contactName": { "type": "string", "description": "Contact display name at time of interaction." },
        "phone": { "type": "string", "description": "Phone number dialed on WhatsApp." },
        "loggedAtEpochMs": { "type": "integer", "description": "Epoch milliseconds of the interaction." },
        "syncedToPhone": { "type": "boolean", "description": "Whether this contact has been synced to the phonebook." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp." }
      },
      "required": ["contactId", "contactName", "phone", "loggedAtEpochMs", "syncedToPhone", "createdAt", "updatedAt"]
    },
    "PaymentTemplate": {
      "title": "PaymentTemplate",
      "description": "Payment service link concatenation template (e.g., InstaPay, Orange Cash, Axis Pay).",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Payment service name." },
        "urlTemplate": { "type": "string", "description": "Template containing {phone} placeholder for concatenation." },
        "isDefault": { "type": "boolean", "description": "Built-in default service flag." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp." }
      },
      "required": ["name", "urlTemplate", "isDefault", "createdAt", "updatedAt"]
    },
    "CallLogRecord": {
      "title": "CallLogRecord",
      "description": "User-scoped call history log synced between local Room and Firestore.",
      "type": "object",
      "properties": {
        "contactId": { "type": "string", "description": "Optional matched sandbox contact ID." },
        "phoneNumber": { "type": "string", "description": "Dialed or received phone number." },
        "cachedName": { "type": "string", "description": "Cached contact name at time of call." },
        "callType": { "type": "integer", "description": "Android CallLog call type (1=Incoming, 2=Outgoing, 3=Missed)." },
        "simSlot": { "type": "integer", "description": "Optional dual-SIM slot index (0 or 1)." },
        "timestampMs": { "type": "integer", "description": "Call start epoch milliseconds." },
        "durationSec": { "type": "integer", "description": "Call duration in seconds." },
        "transcriptId": { "type": "string", "description": "Optional linked transcript ID." },
        "hasRecording": { "type": "boolean", "description": "Whether a local audio recording exists." },
        "notes": { "type": "string", "description": "Short call summary or post-call note." },
        "clientUpdatedAtMs": { "type": "integer", "description": "Client update timestamp for sync resolution." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp." }
      },
      "required": ["phoneNumber", "callType", "timestampMs", "durationSec", "hasRecording", "clientUpdatedAtMs", "createdAt", "updatedAt"]
    },
    "CallTranscriptRecord": {
      "title": "CallTranscriptRecord",
      "description": "Call recording metadata, full transcript, 3-bullet summary, timed segments, and extracted action items.",
      "type": "object",
      "properties": {
        "contactId": { "type": "string", "description": "Optional linked sandbox contact ID." },
        "phone": { "type": "string", "description": "Phone number associated with the call." },
        "contactName": { "type": "string", "description": "Display name at recording time." },
        "audioFileName": { "type": "string", "description": "Filename cached locally in private app storage." },
        "audioSizeBytes": { "type": "integer", "description": "Local audio file size in bytes." },
        "timestampMs": { "type": "integer", "description": "Call timestamp epoch milliseconds." },
        "durationSec": { "type": "integer", "description": "Call duration in seconds." },
        "transcript": { "type": "string", "description": "Full call transcript text." },
        "highlights": { "type": "array", "description": "Key extracted highlights." },
        "summaryBullets": { "type": "array", "description": "3 concise AI summary bullet points." },
        "oneLineSummary": { "type": "string", "description": "One-line pre-call context summary." },
        "segmentsJson": { "type": "string", "description": "Serialized timed speaker transcript segments JSON." },
        "actionItemsJson": { "type": "string", "description": "Serialized action items JSON." },
        "extractedNotes": { "type": "string", "description": "Organized post-call notes." },
        "suggestedEventTitle": { "type": "string", "description": "Suggested calendar follow-up event title." },
        "suggestedEventDateIso": { "type": "string", "description": "Suggested calendar follow-up ISO date." },
        "suggestedEventEpochMs": { "type": "integer", "description": "Suggested calendar follow-up epoch ms." },
        "suggestedCategory": { "type": "string", "description": "Suggested category path." },
        "eventAdded": { "type": "boolean", "description": "Whether calendar event was added." },
        "notesSaved": { "type": "boolean", "description": "Whether notes were saved to contact." },
        "status": { "type": "string", "description": "Transcription status (PENDING, PROCESSING, READY, ERROR, NO_AUDIO)." },
        "clientUpdatedAtMs": { "type": "integer", "description": "Client update timestamp for sync resolution." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp." }
      },
      "required": ["phone", "contactName", "audioSizeBytes", "timestampMs", "durationSec", "highlights", "summaryBullets", "eventAdded", "notesSaved", "status", "clientUpdatedAtMs", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner profile and sync metadata."
    },
    "/users/{userId}/contacts/{contactId}": {
      "schema": { "$ref": "#/entities/ContactRecord" },
      "description": "User-scoped cloud contacts repository."
    },
    "/users/{userId}/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/CategoryNode" },
      "description": "User-scoped nested category hierarchy."
    },
    "/users/{userId}/whatsapp_logs/{logId}": {
      "schema": { "$ref": "#/entities/WhatsAppLog" },
      "description": "User-scoped WhatsApp outreach logs."
    },
    "/users/{userId}/payment_templates/{templateId}": {
      "schema": { "$ref": "#/entities/PaymentTemplate" },
      "description": "User-scoped payment link concatenation templates."
    },
    "/users/{userId}/call_logs/{callLogId}": {
      "schema": { "$ref": "#/entities/CallLogRecord" },
      "description": "User-scoped offline-first call logs synced to cloud."
    },
    "/users/{userId}/call_transcripts/{transcriptId}": {
      "schema": { "$ref": "#/entities/CallTranscriptRecord" },
      "description": "User-scoped AI call transcripts and summaries synced to cloud."
    }
  }
}
